# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# resend.com API key — sends the "new order" notification email.
RESEND_API_KEY=
# Address that receives new-order notifications.
ORDER_NOTIFICATION_EMAIL=
